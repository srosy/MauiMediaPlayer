@implements IAsyncDisposable
@inject PlaybackService Playback
@inject PlaylistService Playlist
@inject MediaSourceService MediaSource
@inject DebugLogService DebugLog
@inject NativeVideoPlaybackService NativeVideo
@inject FavoritesService Favorites
@inject DislikesService Dislikes
@inject SuperLikesService SuperLikes
@inject ToastService Toasts
@inject IFullscreenService Fullscreen
@inject NativePaneSwapDragBridgeService NativePaneSwapBridge
@inject IJSRuntime JS

@{
    var visiblePanes = VisiblePanes;
}

<div class="media-viewport media-split media-split-@visiblePanes.Count @(_isDragOver ? "is-drag-over" : null)"
     @ondragenter="OnDragEnter"
     @ondragover:preventDefault="true"
     @ondragleave="OnDragLeave"
     @ondrop="OnDrop"
     @ondrop:preventDefault="true"
     @onpointermove="OnViewportPointerMoveAsync"
     @onpointerup="OnViewportPointerUpAsync"
     @onpointercancel="OnViewportPointerCancelAsync">
    @if (visiblePanes.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon">
                <Icon Name="play-fill" Size="32" />
            </div>
            <div class="empty-state-title">Ready when you are</div>
            <p class="empty-state-text">Add a folder of photos, GIFs, or videos to start a slideshow. Mosaic plays them all and remembers where you left off.</p>
            <div class="empty-state-actions">
                <button class="btn btn-primary" type="button" @onclick="RequestAddMedia">
                    <Icon Name="plus-lg" Size="14" Class="me-1" />
                    Add media
                </button>
            </div>
            <div class="empty-state-hint">
                Tip: press <kbd class="shortcut-key">?</kbd> for keyboard shortcuts, or paste paths directly in the Add media dialog.
            </div>
        </div>
    }
    else
    {
        @foreach (var pane in visiblePanes)
        {
            @* `is-video-pane` toggles a CSS rule that clips holdover/placeholder
               HTML so it never bleeds beneath the caption gradient (where the
               native MediaElement does not paint). See app.css for details. *@
            <div class="media-pane @(pane.Item.Kind == MediaKind.Video ? "is-video-pane" : null) @(Playback.IsSlotLocked(pane.SlotIndex) ? "is-locked" : null)"
                 data-media-pane
                 data-slot="@pane.SlotIndex">
                <div class="media-pane-status" aria-hidden="true">
                    @if (SuperLikes.IsSuperLiked(pane.Item.FilePath))
                    {
                        <span class="media-pane-status-icon media-pane-status-superlike" title="Super liked">
                            <Icon Name="heart-fire-fill" Size="36" />
                        </span>
                    }
                    @if (Favorites.IsFavorite(pane.Item.FilePath))
                    {
                        <span class="media-pane-status-icon media-pane-status-favorite" title="Favorite">
                            <Icon Name="heart-fill" Size="36" />
                        </span>
                    }
                    @if (Dislikes.IsDisliked(pane.Item.FilePath))
                    {
                        <span class="media-pane-status-icon media-pane-status-dislike" title="Disliked">
                            <Icon Name="heartbreak-fill" Size="36" />
                        </span>
                    }
                    @if (Playback.IsSlotLocked(pane.SlotIndex))
                    {
                        <span class="media-pane-status-icon media-pane-status-lock" title="Locked">
                            <Icon Name="lock-fill" Size="36" />
                        </span>
                    }
                </div>
                <div class="media-pane-zoom-layer"
                     @onpointerdown="e => OnPanePointerDownAsync(pane.SlotIndex, e)">
                @if (pane.Item.Kind == MediaKind.Video)
                {
                    @* Phase 5: extend the Phase 4 hold-over treatment to video panes. The
                       native MediaElement is hidden via reveal-on-Playing (Phase 1) for
                       ~0.5-1s while the platform opens the new source. Without a hold-over
                       the user previously saw a "Playing video in app" placeholder during
                       that window.

                       IMPORTANT: only show the holdover when the IMMEDIATELY PRIOR item
                       for this slot was an image or gif. On video→video transitions the
                       stored URI is from BEFORE the previous video — rendering it during
                       the 1s reveal gap flashes a stale, unrelated image (the original
                       Phase 5 bug). For those transitions we render the placeholder div
                       so the user sees the pane's black background until the native video
                       reveals on top. *@
                    @* Default to Image when the dictionary has no entry yet (very first
                       Playback.Changed after cold start, or a slot freshly added by a
                       split-mode expansion). _lastShownImagePerSlot below is the
                       secondary filter — it's only populated when an image actually
                       rendered in this slot, so defaulting to Image safely permits the
                       holdover ONLY when there's a real image to hold over. Defaulting
                       to Video would lose the legitimate Phase 5 holdover on the very
                       first image→video transition (the dictionary is empty for the
                       first call to UpdateTransitionTrackingPreRender). *@
                    var prevKind = _previousKindPerSlot.GetValueOrDefault(pane.SlotIndex, MediaKind.Image);
                    var prevWasImageOrGif = prevKind is MediaKind.Image or MediaKind.Gif;
                    var prevWasVideo = prevKind == MediaKind.Video;
                    if (prevWasImageOrGif && _lastShownImagePerSlot.TryGetValue(pane.SlotIndex, out var videoHoldover))
                    {
                        <img @key="@($"vh-{pane.SlotIndex}:{pane.Item.Id}")"
                             class="media-image media-image-holdover"
                             src="@videoHoldover"
                             alt=""
                             decoding="async" />
                    }
                    else
                    {
                        @* No fresh image to hold over (first video of the slot, or a
                           video→video transition). Render a transparent surface so the
                           pane shows its own black background — strictly less jarring
                           than a stale image flash or placeholder text. The MediaElement
                           reveals on top within ~1s. *@
                        <div class="native-video-placeholder @(!prevWasVideo ? "native-video-placeholder--spinner" : null)"></div>
                    }
                }
                else if (pane.Item.Kind is MediaKind.Image or MediaKind.Gif)
                {
                    if (_imageErrors.TryGetValue(pane.Item.Id, out var error))
                    {
                        <div class="empty-state text-center">
                            <div class="h4">Could not display image</div>
                            <p class="mb-0 text-white-50">@error</p>
                        </div>
                    }
                    else if (_imageSources.TryGetValue(pane.Item.Id, out var imageSource))
                    {
                        <img @key="@($"ready-{pane.SlotIndex}:{pane.Item.Id}")"
                             class="media-image media-image-ready"
                             src="@imageSource"
                             alt="@pane.Item.DisplayName"
                             decoding="async"
                             fetchpriority="high" />
                    }
                    else if (ShouldShowImageHoldover(pane.SlotIndex)
                             && _lastShownImagePerSlot.TryGetValue(pane.SlotIndex, out var holdover))
                    {
                        @* Hold-over only after image→image/gif: using the slot's last URI
                           after a video would flash an unrelated still from much earlier. *@
                        <img @key="@($"ho-{pane.SlotIndex}:{pane.Item.Id}")"
                             class="media-image media-image-holdover"
                             src="@holdover"
                             alt="@pane.Item.DisplayName"
                             decoding="async" />
                    }
                    else
                    {
                        @* True cold start (first item for this slot, nothing to hold over). *@
                        <div class="empty-state text-center">
                            <div class="h4">Loading image...</div>
                            <p class="mb-0 text-white-50">@pane.Item.DisplayName</p>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state text-center">
                        <div class="h4">Unsupported media</div>
                        <p class="mb-0 text-white-50">@pane.Item.DisplayName</p>
                    </div>
                }
                </div>

                <div class="media-caption">
                    <span class="media-caption-title">@pane.Item.DisplayName</span>
                    <span class="media-caption-actions">
                        <button class="media-superlike-btn @(SuperLikes.IsSuperLiked(pane.Item.FilePath) ? "is-superliked" : null)"
                                type="button"
                                title="@(SuperLikes.IsSuperLiked(pane.Item.FilePath) ? "Remove super like" : "Super like")"
                                aria-label="@(SuperLikes.IsSuperLiked(pane.Item.FilePath) ? "Remove super like" : "Super like")"
                                aria-pressed="@(SuperLikes.IsSuperLiked(pane.Item.FilePath) ? "true" : "false")"
                                @onclick="() => ToggleSuperLikeAsync(pane.Item)"
                                @onclick:stopPropagation="true">
                            <Icon Name="@(SuperLikes.IsSuperLiked(pane.Item.FilePath) ? "heart-fire-fill" : "heart-fire")" Size="18" />
                        </button>
                        <button class="media-favorite-btn @(Favorites.IsFavorite(pane.Item.FilePath) ? "is-favorited" : null)"
                                type="button"
                                title="@(Favorites.IsFavorite(pane.Item.FilePath) ? "Remove from favorites" : "Add to favorites")"
                                aria-label="@(Favorites.IsFavorite(pane.Item.FilePath) ? "Remove from favorites" : "Add to favorites")"
                                aria-pressed="@(Favorites.IsFavorite(pane.Item.FilePath) ? "true" : "false")"
                                @onclick="() => ToggleFavoriteAsync(pane.Item)"
                                @onclick:stopPropagation="true">
                            <Icon Name="@(Favorites.IsFavorite(pane.Item.FilePath) ? "heart-fill" : "heart")" Size="18" />
                        </button>
                        <button class="media-dislike-btn @(Dislikes.IsDisliked(pane.Item.FilePath) ? "is-disliked" : null)"
                                type="button"
                                title="@(Dislikes.IsDisliked(pane.Item.FilePath) ? "Remove dislike" : "Dislike")"
                                aria-label="@(Dislikes.IsDisliked(pane.Item.FilePath) ? "Remove dislike" : "Dislike")"
                                aria-pressed="@(Dislikes.IsDisliked(pane.Item.FilePath) ? "true" : "false")"
                                @onclick="() => ToggleDislikeAsync(pane.Item)"
                                @onclick:stopPropagation="true">
                            <Icon Name="@(Dislikes.IsDisliked(pane.Item.FilePath) ? "heartbreak-fill" : "heartbreak")" Size="18" />
                        </button>
                        <button class="media-lock-btn @(Playback.IsSlotLocked(pane.SlotIndex) ? "is-locked" : null)"
                                type="button"
                                title="@(Playback.IsSlotLocked(pane.SlotIndex) ? "Unlock pane" : "Lock pane")"
                                aria-label="@(Playback.IsSlotLocked(pane.SlotIndex) ? "Unlock pane" : "Lock pane")"
                                aria-pressed="@(Playback.IsSlotLocked(pane.SlotIndex) ? "true" : "false")"
                                @onclick="() => ToggleLockAsync(pane.SlotIndex)"
                                @onclick:stopPropagation="true">
                            <Icon Name="@(Playback.IsSlotLocked(pane.SlotIndex) ? "lock-fill" : "unlock")" Size="12" />
                        </button>
                        <button class="media-back-btn"
                                type="button"
                                disabled="@(!Playback.CanGoBackSlot(pane.SlotIndex))"
                                title="@GetBackButtonTitle(pane.SlotIndex)"
                                aria-label="@GetBackButtonAriaLabel(pane.SlotIndex)"
                                @onclick="() => GoBackSlotAsync(pane.SlotIndex)"
                                @onclick:stopPropagation="true">
                            <Icon Name="skip-start-fill" Size="12" />
                        </button>
                        <button class="media-skip-btn"
                                type="button"
                                disabled="@(Playback.IsSlotLocked(pane.SlotIndex))"
                                title="Skip this pane to the next item"
                                aria-label="Skip pane"
                                @onclick="() => SkipSlotAsync(pane.SlotIndex)"
                                @onclick:stopPropagation="true">
                            <Icon Name="skip-forward-fill" Size="12" />
                        </button>
                        <span class="media-caption-kind">@pane.Item.Kind</span>
                    </span>
                </div>
            </div>
        }

        @if (Playback.Status == PlaybackStatus.Paused)
        {
            <button class="media-pause-overlay"
                    type="button"
                    title="Resume playback"
                    aria-label="Resume playback"
                    @onclick="OnPauseOverlayClickAsync">
                <span class="media-pause-overlay-icon @( _pauseOverlayShowPauseIcon ? "is-pause-flash" : null)">
                    <Icon Name="@(_pauseOverlayShowPauseIcon ? "pause-fill" : "play-fill")" Size="72" />
                </span>
            </button>
        }
    }
</div>

@code {
    [Parameter] public EventCallback OnRequestAddMedia { get; set; }
    [Parameter] public EventCallback<string[]> OnDroppedPaths { get; set; }

    private const int MaxPanes = 3;
    private const double PaneDragThresholdPx = 8;
    private const double PaneDragGhostOffsetPx = 18;
    private readonly Dictionary<Guid, string> _imageSources = [];
    private readonly Dictionary<Guid, string> _imageErrors = [];
    private readonly HashSet<Guid> _loadingImageIds = [];
    // Slot -> last successfully shown data URI. Phase 4 hold-over: when a slot swaps
    // to a new item whose data URI is not yet ready we render this URI instead of the
    // "Loading image..." placeholder, so the user sees continuous content.
    private readonly Dictionary<int, string> _lastShownImagePerSlot = [];
    // Slot -> the kind of the item this slot was rendering BEFORE the current one.
    // Used by the video pane markup to suppress the (otherwise stale) holdover during
    // video→video transitions. Updated in UpdateTransitionTrackingPreRender BEFORE the
    // re-render fires, so the very first render after a transition already sees the
    // correct previous kind. Without this, video X→video Y would flash whatever image
    // was last shown in this slot (potentially minutes old) for ~1s while the
    // MediaElement opens Y's new source.
    private readonly Dictionary<int, MediaKind> _previousKindPerSlot = [];
    private readonly Dictionary<int, Guid> _lastObservedItemIdPerSlot = [];
    private readonly Dictionary<int, MediaKind> _lastObservedKindPerSlot = [];
    private DotNetObjectReference<MediaViewport>? _dotNetReference;
    private bool _isDragOver;
    // Browsers fire dragenter/dragleave on child elements too. Without a counter,
    // dragging over any inner element triggers leave -> enter spasms and the drop
    // indicator flickers. Tracking enter/leave parity gives a stable signal:
    // indicator is visible iff _dragEnterCount > 0.
    private int _dragEnterCount;
    // Pane assignment key — bounds are re-synced when this changes, not on every
    // image decode (which was re-positioning native video overlays unnecessarily).
    private string? _lastBoundsSyncKey;
    private bool _pauseOverlayShowPauseIcon;
    private CancellationTokenSource? _pauseOverlayCts;
    private bool _paneDragUsesJsSession;
    private bool _paneDragDeferredRefresh;

    private IReadOnlyList<VisibleMediaSlot> VisiblePanes => Playback.VisiblePanes;

    private bool _nativePaneDragActive;
    private int _nativePaneDragSlot = -1;

    private bool CanPaneDragSwap => Playback.Settings.SplitScreenCount >= 2 && VisiblePanes.Count >= 2;

    protected override void OnInitialized()
    {
        Playback.Changed += OnPlaybackChanged;
        Playlist.Changed += OnPlaybackChanged;
        Favorites.Changed += OnFavoritesChanged;
        Dislikes.Changed += OnDislikesChanged;
        SuperLikes.Changed += OnSuperLikesChanged;
        Fullscreen.FullscreenChanged += OnFullscreenChanged;

        NativePaneSwapBridge.Register(
            () => CanPaneDragSwap,
            StartNativePaneSwapDragAsync,
            UpdateNativePaneSwapDragAsync,
            CompleteNativePaneSwapDragAsync);
    }

    private async Task ToggleSuperLikeAsync(MediaItem item)
    {
        if (Dislikes.IsDisliked(item.FilePath))
        {
            Dislikes.Remove(item.FilePath);
        }

        var added = SuperLikes.Toggle(item.FilePath);
        Toasts.Info(added ? $"Super liked: {item.DisplayName}" : $"Removed super like: {item.DisplayName}");
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleFavoriteAsync(MediaItem item)
    {
        if (Dislikes.IsDisliked(item.FilePath))
        {
            Dislikes.Remove(item.FilePath);
        }

        var added = Favorites.Toggle(item.FilePath);
        Toasts.Info(added ? $"Added to favorites: {item.DisplayName}" : $"Removed from favorites: {item.DisplayName}");
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleDislikeAsync(MediaItem item)
    {
        if (Favorites.IsFavorite(item.FilePath))
        {
            Favorites.Toggle(item.FilePath);
        }

        if (SuperLikes.IsSuperLiked(item.FilePath))
        {
            SuperLikes.Remove(item.FilePath);
        }

        var added = Dislikes.Toggle(item.FilePath);
        Toasts.Info(added ? $"Disliked: {item.DisplayName}" : $"Removed dislike: {item.DisplayName}");
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnPauseOverlayClickAsync()
    {
        _pauseOverlayCts?.Cancel();
        _pauseOverlayCts = new CancellationTokenSource();
        var token = _pauseOverlayCts.Token;

        _pauseOverlayShowPauseIcon = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            await Task.Delay(400, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (Playback.Status == PlaybackStatus.Paused)
        {
            await Playback.PlayAsync();
        }

        _pauseOverlayShowPauseIcon = false;
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleLockAsync(int slotIndex)
    {
        Playback.ToggleSlotLock(slotIndex);
    }

    private async Task GoBackSlotAsync(int slotIndex)
    {
        try
        {
            await Playback.GoBackSlotAsync(slotIndex);
        }
        catch (Exception exception)
        {
            DebugLog.Error($"Back failed for slot {slotIndex + 1}: {exception.Message}");
        }
    }

    private string GetBackButtonTitle(int slotIndex) =>
        Playback.CanUndoDislikeOnSlot(slotIndex)
            ? "Remove dislike"
            : "Go back to previous item";

    private string GetBackButtonAriaLabel(int slotIndex) =>
        Playback.CanUndoDislikeOnSlot(slotIndex)
            ? "Remove dislike"
            : "Go back";

    private void OnFavoritesChanged()
    {
        if (_paneDragUsesJsSession)
        {
            return;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private void OnDislikesChanged()
    {
        if (_paneDragUsesJsSession)
        {
            return;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private void OnSuperLikesChanged()
    {
        if (_paneDragUsesJsSession)
        {
            return;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private void LogPaneSwap(string level, string message)
    {
        switch (level.ToUpperInvariant())
        {
            case "TRACE":
                DebugLog.Trace($"PaneSwap: {message}");
                break;
            case "DEBUG":
                DebugLog.Debug($"PaneSwap: {message}");
                break;
            case "ERROR":
                DebugLog.Error($"PaneSwap: {message}");
                break;
            default:
                DebugLog.Info($"PaneSwap: {message}");
                break;
        }
    }

    private async Task OnPanePointerDownAsync(int slotIndex, PointerEventArgs args)
    {
        if (!CanPaneDragSwap || args.Button != 0)
        {
            if (args.Button == 0)
            {
                LogPaneSwap(
                    "DEBUG",
                    $"pointerdown ignored on slot {slotIndex + 1}: CanPaneDragSwap=false (split={Playback.Settings.SplitScreenCount}; visiblePanes={VisiblePanes.Count}).");
            }

            return;
        }

        if (_paneDragUsesJsSession)
        {
            LogPaneSwap("DEBUG", "pointerdown ignored — drag session already active.");
            return;
        }

        _paneDragUsesJsSession = true;

        LogPaneSwap(
            "DEBUG",
            $"pointerdown slot {slotIndex + 1}; pointerId={args.PointerId}; at=({args.ClientX:0},{args.ClientY:0}); status={Playback.Status}.");

        _dotNetReference ??= DotNetObjectReference.Create(this);

        try
        {
            await JS.InvokeVoidAsync(
                "mauiMediaPlayer.startPaneSwapDrag",
                _dotNetReference,
                (int)args.PointerId,
                slotIndex,
                args.ClientX,
                args.ClientY,
                PaneDragThresholdPx,
                PaneDragGhostOffsetPx);
        }
        catch (JSDisconnectedException)
        {
            LogPaneSwap("ERROR", "startPaneSwapDrag failed — JS disconnected.");
            _paneDragUsesJsSession = false;
        }

        // Intentionally no StateHasChanged — drag visuals are JS-only until release.
    }

    private async Task StartNativePaneSwapDragAsync(int slotIndex, double clientX, double clientY)
    {
        if (!CanPaneDragSwap)
        {
            LogPaneSwap(
                "DEBUG",
                $"native pan ignored on slot {slotIndex + 1}: CanPaneDragSwap=false (split={Playback.Settings.SplitScreenCount}; visiblePanes={VisiblePanes.Count}).");
            return;
        }

        if (_paneDragUsesJsSession)
        {
            LogPaneSwap("DEBUG", "native pan ignored — drag session already active.");
            return;
        }

        _paneDragUsesJsSession = true;
        _nativePaneDragActive = true;
        _nativePaneDragSlot = slotIndex;

        LogPaneSwap(
            "DEBUG",
            $"native pan begin slot {slotIndex + 1}; at=({clientX:0},{clientY:0}); status={Playback.Status}.");

        _dotNetReference ??= DotNetObjectReference.Create(this);

        await NativeVideo.SetPaneSwapSuppressedAsync(slotIndex, suppress: true);

        try
        {
            await JS.InvokeVoidAsync(
                "mauiMediaPlayer.startPaneSwapDragFromNative",
                _dotNetReference,
                slotIndex,
                clientX,
                clientY,
                PaneDragThresholdPx,
                PaneDragGhostOffsetPx);
        }
        catch (JSDisconnectedException)
        {
            LogPaneSwap("ERROR", "startPaneSwapDragFromNative failed — JS disconnected.");
            await ClearNativePaneDragStateAsync();
        }
    }

    private async Task UpdateNativePaneSwapDragAsync(int slotIndex, double clientX, double clientY)
    {
        if (!_nativePaneDragActive || slotIndex != _nativePaneDragSlot)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("mauiMediaPlayer.updatePaneSwapDragFromNative", clientX, clientY);
        }
        catch (JSDisconnectedException)
        {
            LogPaneSwap("ERROR", "updatePaneSwapDragFromNative failed — JS disconnected.");
        }
    }

    private async Task CompleteNativePaneSwapDragAsync(int slotIndex, double clientX, double clientY, bool canceled)
    {
        if (!_nativePaneDragActive || slotIndex != _nativePaneDragSlot)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync(
                "mauiMediaPlayer.finishPaneSwapDragFromNative",
                clientX,
                clientY,
                canceled ? "native-cancel" : "native-up");
        }
        catch (JSDisconnectedException)
        {
            LogPaneSwap("ERROR", "finishPaneSwapDragFromNative failed — JS disconnected.");
            await ClearNativePaneDragStateAsync();
        }
    }

    [JSInvokable]
    public async Task OnPaneSwapDragArmed(int sourceSlot)
    {
        LogPaneSwap("DEBUG", $"armed callback for slot {sourceSlot + 1}; suppressing native video overlays for hit-testing.");

        NativePaneSwapBridge.NotifyNativeDragArmed();

        foreach (var pane in VisiblePanes.Where(p => p.Item.Kind == MediaKind.Video))
        {
            await NativeVideo.SetPaneSwapSuppressedAsync(pane.SlotIndex, suppress: true);
        }
    }

    private async Task ClearNativePaneDragStateAsync()
    {
        _nativePaneDragActive = false;
        _nativePaneDragSlot = -1;
        _paneDragUsesJsSession = false;
        await NativeVideo.ClearPaneSwapSuppressionAsync();
    }

    [JSInvokable]
    public async Task OnPaneSwapDragComplete(int sourceSlot, int targetSlot, bool armed, string reason)
    {
        var deferredRefresh = _paneDragDeferredRefresh;
        _paneDragUsesJsSession = false;
        _paneDragDeferredRefresh = false;
        _nativePaneDragActive = false;
        _nativePaneDragSlot = -1;

        await NativeVideo.ClearPaneSwapSuppressionAsync();

        LogPaneSwap(
            "DEBUG",
            $"complete ({reason}); armed={armed}; source slot {sourceSlot + 1}; target={(targetSlot >= 0 ? $"slot {targetSlot + 1}" : "none")}.");

        var swapped = armed && targetSlot >= 0 && targetSlot != sourceSlot;

        if (swapped)
        {
            LogPaneSwap("DEBUG", $"committing swap slot {sourceSlot + 1} ↔ slot {targetSlot + 1}.");
            SwapViewportSlotState(sourceSlot, targetSlot);
            await Playback.SwapSlotsAsync(sourceSlot, targetSlot);
            await InvalidatePaneZoomAsync();
            NativeVideo.RequestLayoutBoundsResync();

            try
            {
                await JS.InvokeVoidAsync("mauiMediaPlayer.invalidateMediaPaneBoundsCache");
                await JS.InvokeVoidAsync("mauiMediaPlayer.requestMediaPaneBoundsFlush");
            }
            catch (JSDisconnectedException)
            {
            }

            await UpdateNativeVideoBoundsAsync();
        }
        else if (armed)
        {
            LogPaneSwap("DEBUG", "released without swap — no valid drop target.");
        }
        else
        {
            LogPaneSwap("DEBUG", "released before drag threshold — treated as click.");
        }

        // SwapSlotsAsync fires NotifyChanged which refreshes the viewport. Only run an
        // explicit refresh when the drag ended without a swap but slots advanced underneath.
        if (!swapped && deferredRefresh)
        {
            await RefreshAfterPlaybackChangedAsync();
        }
        else if (!swapped)
        {
            await InvalidatePaneZoomAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task OnViewportPointerMoveAsync(PointerEventArgs args)
    {
        if (_paneDragUsesJsSession)
        {
            return Task.CompletedTask;
        }

        return Task.CompletedTask;
    }

    private Task OnViewportPointerUpAsync(PointerEventArgs args)
    {
        if (_paneDragUsesJsSession)
        {
            LogPaneSwap("TRACE", $"viewport pointerup ignored (JS session); pointerId={args.PointerId}.");
        }

        return Task.CompletedTask;
    }

    private Task OnViewportPointerCancelAsync(PointerEventArgs args)
    {
        if (_paneDragUsesJsSession)
        {
            LogPaneSwap("TRACE", $"viewport pointercancel ignored (JS session); pointerId={args.PointerId}.");
        }

        return Task.CompletedTask;
    }

    private async Task ClearPaneDragStateAsync()
    {
        if (!_paneDragUsesJsSession)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("mauiMediaPlayer.stopPaneSwapDrag", _dotNetReference, "clear");
        }
        catch (JSDisconnectedException)
        {
        }

        _paneDragUsesJsSession = false;
    }

    private void SwapViewportSlotState(int slotA, int slotB)
    {
        SwapDictionaryEntry(_lastShownImagePerSlot, slotA, slotB);
        SwapDictionaryEntry(_previousKindPerSlot, slotA, slotB);
        SwapDictionaryEntry(_lastObservedItemIdPerSlot, slotA, slotB);
        SwapDictionaryEntry(_lastObservedKindPerSlot, slotA, slotB);
    }

    private static void SwapDictionaryEntry(Dictionary<int, string> dict, int slotA, int slotB) =>
        SwapDictionaryEntries(dict, slotA, slotB);

    private static void SwapDictionaryEntry(Dictionary<int, MediaKind> dict, int slotA, int slotB) =>
        SwapDictionaryEntries(dict, slotA, slotB);

    private static void SwapDictionaryEntry(Dictionary<int, Guid> dict, int slotA, int slotB) =>
        SwapDictionaryEntries(dict, slotA, slotB);

    private static void SwapDictionaryEntries<T>(Dictionary<int, T> dict, int slotA, int slotB)
    {
        var hasA = dict.ContainsKey(slotA);
        var hasB = dict.ContainsKey(slotB);

        if (!hasA && !hasB)
        {
            return;
        }

        if (!hasA)
        {
            dict[slotA] = dict[slotB];
            dict.Remove(slotB);
            return;
        }

        if (!hasB)
        {
            dict[slotB] = dict[slotA];
            dict.Remove(slotA);
            return;
        }

        (dict[slotA], dict[slotB]) = (dict[slotB], dict[slotA]);
    }

    private Task RequestAddMedia() => OnRequestAddMedia.InvokeAsync();

    private void OnDragEnter(DragEventArgs args)
    {
        if (!HasFiles(args))
        {
            return;
        }

        _dragEnterCount++;

        if (!_isDragOver)
        {
            _isDragOver = true;
        }
    }

    // No OnDragOver handler is bound — dragover fires continuously (60+/sec) while
    // a drag is held; we already know we're hovering from the enter event. Using
    // only @ondragover:preventDefault="true" attaches a listener for preventDefault
    // without invoking a C# method, so Blazor never schedules a re-render for them.

    private void OnDragLeave(DragEventArgs args)
    {
        _ = args;

        if (_dragEnterCount > 0)
        {
            _dragEnterCount--;
        }

        if (_dragEnterCount == 0 && _isDragOver)
        {
            _isDragOver = false;
        }
    }

    private async Task OnDrop(DragEventArgs args)
    {
        _ = args;
        _dragEnterCount = 0;
        _isDragOver = false;

        // The Blazor DragEventArgs surface does not expose file objects directly.
        // We capture file *names* via JS (WebView2 does not surface OS paths to JS
        // for security reasons) so the parent can surface a useful diagnostic.
        try
        {
            var paths = await JS.InvokeAsync<string[]>("mauiMediaPlayer.collectDroppedPaths");
            if (paths is { Length: > 0 })
            {
                await OnDroppedPaths.InvokeAsync(paths);
            }
        }
        catch (Exception exception)
        {
            DebugLog.Trace($"Drop interop failed: {exception.GetType().Name}: {exception.Message}");
        }
    }

    private static bool HasFiles(DragEventArgs args)
    {
        return args.DataTransfer?.Types?.Any(t => string.Equals(t, "Files", StringComparison.OrdinalIgnoreCase)) == true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetReference ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("mauiMediaPlayer.observeMediaViewportBounds", _dotNetReference);
            try
            {
                await JS.InvokeVoidAsync("mauiMediaPlayer.installPaneZoom");
            }
            catch (JSDisconnectedException)
            {
            }
        }

        var boundsSyncKey = BuildBoundsSyncKey(VisiblePanes);
        if (firstRender || !string.Equals(boundsSyncKey, _lastBoundsSyncKey, StringComparison.Ordinal))
        {
            _lastBoundsSyncKey = boundsSyncKey;
            NativeVideo.RequestLayoutBoundsResync();
            await UpdateNativeVideoBoundsAsync();
            try
            {
                await JS.InvokeVoidAsync("mauiMediaPlayer.ensureMediaPaneObservers");
                await JS.InvokeVoidAsync("mauiMediaPlayer.installPaneZoom");
            }
            catch (JSDisconnectedException)
            {
            }
        }

        await EnsureImageSourcesAsync();
        UpdateHoldoverState();
        PruneImageCache();
        await WatchImageElementsAsync();
    }

    private void OnFullscreenChanged()
    {
        _ = RefreshLayoutAfterFullscreenAsync();
    }

    private async Task RefreshLayoutAfterFullscreenAsync()
    {
        try
        {
            NativeVideo.RequestLayoutBoundsResync();
            await InvokeAsync(StateHasChanged);

            // Layout settles over multiple frames after WinUI switches presenters.
            await FlushNativeBoundsAfterLayoutAsync(0);
            await FlushNativeBoundsAfterLayoutAsync(80);
            await FlushNativeBoundsAfterLayoutAsync(200);
        }
        catch (Exception exception) when (exception is ObjectDisposedException or InvalidOperationException)
        {
            DebugLog.Trace($"Ignored media viewport fullscreen refresh: {exception.Message}");
        }
    }

    private async Task FlushNativeBoundsAfterLayoutAsync(int delayMs)
    {
        if (delayMs > 0)
        {
            await Task.Delay(delayMs);
        }

        try
        {
            await JS.InvokeVoidAsync("mauiMediaPlayer.invalidateMediaPaneBoundsCache");
        }
        catch (JSDisconnectedException)
        {
            return;
        }

        await UpdateNativeVideoBoundsAsync();

        try
        {
            await JS.InvokeVoidAsync("mauiMediaPlayer.requestMediaPaneBoundsFlush");
            await JS.InvokeVoidAsync("mauiMediaPlayer.ensureMediaPaneObservers");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private string BuildBoundsSyncKey(IReadOnlyList<VisibleMediaSlot> panes)
    {
        if (panes.Count == 0)
        {
            return $"empty:{Playback.Settings.SplitScreenMode}";
        }

        return $"{Playback.Settings.SplitScreenMode}|{string.Join('|', panes.Select(static pane => $"{pane.SlotIndex}:{pane.Item.Id:N}:{pane.Item.Kind}"))}";
    }

    private void UpdateHoldoverState()
    {
        // After each render, remember the data URI we showed for each visible slot. The
        // next time the slot swaps to a NEW item whose URI isn't ready yet, the markup
        // will render this URI instead of a "Loading image..." flash.
        foreach (var pane in VisiblePanes)
        {
            if (pane.Item.Kind is not (MediaKind.Image or MediaKind.Gif))
            {
                continue;
            }

            if (_imageSources.TryGetValue(pane.Item.Id, out var current))
            {
                _lastShownImagePerSlot[pane.SlotIndex] = current;
            }
        }

        // Drop holdover entries for slots that are no longer active so we don't keep
        // stale URIs across a split-mode reduction.
        var activeSlots = new HashSet<int>();
        foreach (var pane in VisiblePanes)
        {
            activeSlots.Add(pane.SlotIndex);
        }

        foreach (var slot in _lastShownImagePerSlot.Keys.Where(slot => !activeSlots.Contains(slot)).ToArray())
        {
            _lastShownImagePerSlot.Remove(slot);
        }
    }

    [JSInvokable]
    public Task OnMediaDebugEvent(string level, string message)
    {
        switch (level.ToUpperInvariant())
        {
            case "TRACE":
                DebugLog.Trace(message);
                break;
            case "DEBUG":
                DebugLog.Debug(message);
                break;
            case "ERROR":
                DebugLog.Error(message);
                break;
            default:
                DebugLog.Info(message);
                break;
        }

        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnMediaPaneBoundsChanged(int slotIndex, double x, double y, double width, double height)
    {
        return NativeVideo.SetBoundsAsync(slotIndex, x, y, width, height);
    }

    private void OnPlaybackChanged()
    {
        if (Playback.Status != PlaybackStatus.Paused)
        {
            _pauseOverlayCts?.Cancel();
            _pauseOverlayShowPauseIcon = false;
        }

        if (_paneDragUsesJsSession)
        {
            _paneDragDeferredRefresh = true;
            LogPaneSwap("TRACE", "playback changed during drag — refresh deferred until release.");
            return;
        }

        _ = RefreshAfterPlaybackChangedAsync();
    }

    private async Task SkipSlotAsync(int slotIndex)
    {
        try
        {
            await Playback.SkipSlotAsync(slotIndex);
        }
        catch (Exception exception)
        {
            DebugLog.Error($"Skip failed for slot {slotIndex + 1}: {exception.Message}");
        }
    }

    private async Task InvalidatePaneZoomAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("mauiMediaPlayer.invalidatePaneZoom");
            await JS.InvokeVoidAsync("mauiMediaPlayer.requestMediaPaneBoundsFlush");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task RefreshAfterPlaybackChangedAsync()
    {
        await InvalidatePaneZoomAsync();

        try
        {
            await InvokeAsync(() =>
            {
                // Capture each slot's "previous kind" BEFORE StateHasChanged schedules
                // the render. The markup uses _previousKindPerSlot to decide whether a
                // video pane should show the image holdover (image→video, where the
                // holdover URI is meaningful) or the placeholder div (video→video,
                // where the holdover URI is stale). Updating it here — synchronously
                // before the render — ensures the very first render after a transition
                // already sees the correct value.
                UpdateTransitionTrackingPreRender();
                SeedVisibleImageSourcesFromCache();
                StateHasChanged();
            });
        }
        catch (Exception exception) when (exception is ObjectDisposedException or InvalidOperationException)
        {
            DebugLog.Trace($"Ignored media viewport refresh after disposal: {exception.Message}");
        }
    }

    private void UpdateTransitionTrackingPreRender()
    {
        foreach (var pane in VisiblePanes)
        {
            var lastObservedId = _lastObservedItemIdPerSlot.GetValueOrDefault(pane.SlotIndex);

            // Only record a "previous kind" when the item identity actually changes.
            // Intermediate re-renders that happen while the slot is still on the SAME
            // item (e.g. another slot fires Changed) must not clobber the captured
            // transition info — otherwise the holdover during a long-lasting video
            // load would briefly flip from "show holdover" to "show placeholder" the
            // moment any peer slot updates.
            if (lastObservedId != Guid.Empty && lastObservedId != pane.Item.Id)
            {
                // Look up the kind of the item we WERE rendering before this swap.
                // We can derive it cheaply by remembering only the kind alongside the
                // id (we don't need the full MediaItem reference).
                var previousKind = _lastObservedKindPerSlot.GetValueOrDefault(pane.SlotIndex, MediaKind.Video);
                _previousKindPerSlot[pane.SlotIndex] = previousKind;

                // After video (or an unsupported kind), drop the slot holdover URI so a
                // later image load cannot flash a still from before the video segment.
                if (previousKind is not (MediaKind.Image or MediaKind.Gif))
                {
                    _lastShownImagePerSlot.Remove(pane.SlotIndex);
                }
            }

            _lastObservedItemIdPerSlot[pane.SlotIndex] = pane.Item.Id;
            _lastObservedKindPerSlot[pane.SlotIndex] = pane.Item.Kind;
        }

        // Drop tracking for slots that are no longer visible so future split-mode
        // changes don't carry stale "previous kind" hints across reductions.
        var activeSlots = new HashSet<int>();
        foreach (var pane in VisiblePanes)
        {
            activeSlots.Add(pane.SlotIndex);
        }

        foreach (var slot in _previousKindPerSlot.Keys.Where(slot => !activeSlots.Contains(slot)).ToArray())
        {
            _previousKindPerSlot.Remove(slot);
        }

        foreach (var slot in _lastObservedItemIdPerSlot.Keys.Where(slot => !activeSlots.Contains(slot)).ToArray())
        {
            _lastObservedItemIdPerSlot.Remove(slot);
        }

        foreach (var slot in _lastObservedKindPerSlot.Keys.Where(slot => !activeSlots.Contains(slot)).ToArray())
        {
            _lastObservedKindPerSlot.Remove(slot);
        }
    }

    private void SeedVisibleImageSourcesFromCache()
    {
        foreach (var item in VisiblePanes.Select(static pane => pane.Item).Where(static item => item.Kind is MediaKind.Image or MediaKind.Gif))
        {
            if (_imageSources.ContainsKey(item.Id) || _imageErrors.ContainsKey(item.Id))
            {
                continue;
            }

            if (!MediaSource.TryGetCachedFullDisplayUri(item.Id, out var cachedUri)
                && !MediaSource.TryGetCachedDisplayUri(item.Id, out cachedUri))
            {
                continue;
            }

            _imageSources[item.Id] = cachedUri;

            foreach (var pane in VisiblePanes.Where(p => p.Item.Id == item.Id))
            {
                _lastShownImagePerSlot[pane.SlotIndex] = cachedUri;
            }
        }
    }

    private async Task EnsureImageSourcesAsync()
    {
        SeedVisibleImageSourcesFromCache();

        foreach (var item in VisiblePanes.Select(static pane => pane.Item).Where(static item => item.Kind is MediaKind.Image or MediaKind.Gif))
        {
            if (_imageSources.ContainsKey(item.Id) || _imageErrors.ContainsKey(item.Id) || !_loadingImageIds.Add(item.Id))
            {
                continue;
            }

            DebugLog.Debug($"Preparing {item.Kind} for display: {item.DisplayName}; path={item.FilePath}.");

            _ = LoadImageSourceAsync(item);
        }

        await Task.CompletedTask;
    }

    private async Task LoadImageSourceAsync(MediaItem item)
    {
        try
        {
            if (!MediaSource.UsesViewportThumbnailOnly(item)
                && MediaSource.TryGetCachedFullDisplayUri(item.Id, out var alreadyCached))
            {
                if (IsVisibleItem(item.Id))
                {
                    await AttachImageSourceAsync(item, alreadyCached);
                }

                return;
            }

            if (MediaSource.UsesViewportThumbnailOnly(item)
                && MediaSource.TryGetCachedThumbnailUri(item.Id, out var cachedViewportThumb))
            {
                if (IsVisibleItem(item.Id))
                {
                    await AttachImageSourceAsync(item, cachedViewportThumb);
                }

                return;
            }

            var thumbnail = await MediaSource.GetThumbnailDataUriAsync(item);

            if (!IsVisibleItem(item.Id))
            {
                DebugLog.Trace($"Discarding stale image source for {item.DisplayName}; current panes changed before display.");
                return;
            }

            // Files under the thumbnail threshold load the full image in GetThumbnailDataUriAsync.
            // Attach once — do not paint a holdover <img> and then swap to a second <img> with
            // the same data URI (that decoded the image twice in the WebView).
            if (!MediaSource.UsesViewportThumbnailOnly(item)
                && MediaSource.TryGetCachedFullDisplayUri(item.Id, out var fullFromThumbnailPath))
            {
                await AttachImageSourceAsync(item, fullFromThumbnailPath);
                return;
            }

            if (MediaSource.UsesViewportThumbnailOnly(item))
            {
                if (!IsVisibleItem(item.Id))
                {
                    DebugLog.Trace($"Discarding stale image source for {item.DisplayName}; current panes changed before display.");
                    return;
                }

                if (MediaSource.TryGetCachedThumbnailUri(item.Id, out var viewportThumbnail))
                {
                    await AttachImageSourceAsync(item, viewportThumbnail);
                    return;
                }

                if (string.IsNullOrEmpty(thumbnail))
                {
                    throw new InvalidOperationException($"Could not generate a viewport thumbnail for {item.DisplayName}.");
                }

                await AttachImageSourceAsync(item, thumbnail);
                return;
            }

            var imageSource = await MediaSource.GetImageDataUriAsync(item);

            if (!IsVisibleItem(item.Id))
            {
                DebugLog.Trace($"Discarding stale image source for {item.DisplayName}; current panes changed before display.");
                return;
            }

            await PrewarmInWebViewAsync(imageSource, item.DisplayName);

            if (!IsVisibleItem(item.Id))
            {
                DebugLog.Trace($"Discarding stale image source for {item.DisplayName}; pane changed during prewarm.");
                return;
            }

            await AttachImageSourceAsync(item, imageSource);
        }
        catch (Exception exception)
        {
            if (!IsVisibleItem(item.Id))
            {
                DebugLog.Trace($"Discarding stale image error for {item.DisplayName}; current panes changed before error display.");
                return;
            }

            await InvokeAsync(() =>
            {
                _imageErrors[item.Id] = exception.Message;
                StateHasChanged();
            });
            DebugLog.Error($"Image source failed for {item.DisplayName}: {exception.Message}");
        }
        finally
        {
            await InvokeAsync(() => _loadingImageIds.Remove(item.Id));
        }
    }

    private async Task AttachImageSourceAsync(MediaItem item, string imageSource)
    {
        await InvokeAsync(() =>
        {
            _imageSources[item.Id] = imageSource;

            foreach (var pane in VisiblePanes.Where(p => p.Item.Id == item.Id))
            {
                _lastShownImagePerSlot[pane.SlotIndex] = imageSource;
            }

            StateHasChanged();
        });
        DebugLog.Info($"Image source ready: {item.DisplayName}.");
    }

    private async Task PrewarmInWebViewAsync(string dataUri, string displayName)
    {
        if (dataUri.Length > 4_000_000)
        {
            return;
        }

        try
        {
            var prewarmed = await JS.InvokeAsync<bool>("mauiMediaPlayer.prewarmImage", dataUri, 3000)
                .AsTask()
                .WaitAsync(TimeSpan.FromSeconds(3));

            if (!prewarmed)
            {
                DebugLog.Trace($"Image prewarm reported failure for {displayName}; proceeding with attach anyway.");
            }
        }
        catch (Exception exception) when (exception is JSDisconnectedException or TimeoutException or TaskCanceledException)
        {
            DebugLog.Trace($"Image prewarm skipped for {displayName}: {exception.GetType().Name}.");
        }
        catch (Exception exception)
        {
            DebugLog.Trace($"Image prewarm faulted for {displayName}: {exception.GetType().Name}: {exception.Message}");
        }
    }

    private bool IsVisibleItem(Guid itemId)
    {
        return VisiblePanes.Any(pane => pane.Item.Id == itemId);
    }

    private bool ShouldShowImageHoldover(int slotIndex) =>
        _previousKindPerSlot.GetValueOrDefault(slotIndex) is MediaKind.Image or MediaKind.Gif;

    private void PruneImageCache()
    {
        var visibleIds = VisiblePanes.Select(static pane => pane.Item.Id).ToHashSet();

        foreach (var imageId in _imageSources.Keys.Where(imageId => !visibleIds.Contains(imageId)).ToArray())
        {
            _imageSources.Remove(imageId);
        }

        foreach (var imageId in _imageErrors.Keys.Where(imageId => !visibleIds.Contains(imageId)).ToArray())
        {
            _imageErrors.Remove(imageId);
        }
    }

    private async Task UpdateNativeVideoBoundsAsync()
    {
        try
        {
            for (var slotIndex = 0; slotIndex < MaxPanes; slotIndex++)
            {
                var bounds = await JS.InvokeAsync<ViewportBounds>("mauiMediaPlayer.getMediaPaneBounds", slotIndex);
                await NativeVideo.SetBoundsAsync(slotIndex, bounds.X, bounds.Y, bounds.Width, bounds.Height);
            }
        }
        catch (Exception exception)
        {
            DebugLog.Trace($"Could not update native video bounds yet: {exception.Message}");
        }
    }

    private sealed class ViewportBounds
    {
        [System.Text.Json.Serialization.JsonPropertyName("x")]
        public double X { get; set; }

        [System.Text.Json.Serialization.JsonPropertyName("y")]
        public double Y { get; set; }

        [System.Text.Json.Serialization.JsonPropertyName("width")]
        public double Width { get; set; }

        [System.Text.Json.Serialization.JsonPropertyName("height")]
        public double Height { get; set; }
    }

    private async Task WatchImageElementsAsync()
    {
        if (_dotNetReference is null)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("mauiMediaPlayer.watchImages", _dotNetReference);
        }
        catch (Exception exception) when (exception is JSDisconnectedException or InvalidOperationException)
        {
            DebugLog.Trace($"Could not watch image elements: {exception.GetType().Name}.");
        }
    }

    public async ValueTask DisposeAsync()
    {
        Playback.Changed -= OnPlaybackChanged;
        Playlist.Changed -= OnPlaybackChanged;
        Favorites.Changed -= OnFavoritesChanged;
        Dislikes.Changed -= OnDislikesChanged;
        SuperLikes.Changed -= OnSuperLikesChanged;
        _pauseOverlayCts?.Cancel();
        _pauseOverlayCts?.Dispose();
        Fullscreen.FullscreenChanged -= OnFullscreenChanged;
        NativePaneSwapBridge.Unregister();

        try
        {
            await JS.InvokeVoidAsync("mauiMediaPlayer.stopPaneSwapDrag", _dotNetReference, "dispose");
            await JS.InvokeVoidAsync("mauiMediaPlayer.disposeMediaViewportBoundsObserver");
        }
        catch (JSDisconnectedException)
        {
        }

        _paneDragUsesJsSession = false;
        _paneDragDeferredRefresh = false;
        _nativePaneDragActive = false;
        _nativePaneDragSlot = -1;

        await NativeVideo.ClearPaneSwapSuppressionAsync();

        _dotNetReference?.Dispose();
    }
}
